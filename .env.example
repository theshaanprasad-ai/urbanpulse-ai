# UrbanPulse AI - Environment Configuration Example
# Copy this file to .env and fill in your own values. Never commit .env.
# This file must contain PLACEHOLDERS ONLY - no real project refs, keys or passwords.

APP_NAME="UrbanPulse AI"
APP_ENV="development"
DEBUG=true
PORT=8000
HOST="0.0.0.0"
DATA_MODE="LIVE"
DEFAULT_CITY="chennai"
# Seeds the synthetic Chennai demo dataset on a fresh database so the control room
# is populated for a first demo. Set to "false" for a fixture-free live deployment.
SEED_DEMO_DATA="true"

# Supabase: use either SUPABASE_DB_PASSWORD or a complete SUPABASE_DB_URL.
# Rotate any credential that has ever been committed, then keep it only in .env.
SUPABASE_URL="https://<your-project-ref>.supabase.co"
SUPABASE_ANON_KEY="<your-supabase-anon-key>"
SUPABASE_DB_PASSWORD="<your-database-password>"
# Transaction pooler (port 6543) requires SQLAlchemy prepare_threshold=None,
# which backend/app/core/database.py already sets.
SUPABASE_DB_URL="postgresql+psycopg://postgres.<your-project-ref>:<your-database-password>@aws-0-<region>.pooler.supabase.com:6543/postgres"

# Frontend auth (the anon key is the public client key). Vite only reads VITE_ variables.
VITE_SUPABASE_URL="https://<your-project-ref>.supabase.co"
VITE_SUPABASE_ANON_KEY="<your-supabase-anon-key>"
# Origin of a deployed backend, needed once the frontend is hosted separately
# (e.g. Vercel). Leave unset for local dev, where the Vite proxy handles /api.
# VITE_API_BASE_URL="https://your-backend-host"

# SQLite is only a local fallback when Supabase is not configured.
DATABASE_URL="sqlite:///./urbanpulse.db"

# Optional providers. Keep all secrets in .env or backend/.env only.
# The Gemini key is used only by the backend and is never sent to the browser.
IMD_API_KEY=""
OPEN_METEO_API_KEY=""
BHUVAN_NRSC_TOKEN=""
MAP_TILES_TOKEN=""
GEMINI_API_KEY=""

SECRET_KEY="change-in-production"
ALLOWED_ORIGINS="http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173"

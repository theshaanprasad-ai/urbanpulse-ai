# MonsoonWatch India - Environment Configuration Example
# Copy this file to .env and configure as needed. Never commit .env.

APP_NAME="MonsoonWatch India"
APP_ENV="development"
DEBUG=true
PORT=8000
HOST="0.0.0.0"
DATA_MODE="LIVE"
DEFAULT_CITY="chennai"
# Seeds the synthetic Chennai demo dataset on a fresh database so the control room
# is populated for a first demo. Set to "false" for a fixture-free live deployment.
SEED_DEMO_DATA="true"

# Supabase: use either SUPABASE_DB_PASSWORD or a complete SUPABASE_DB_URL.
SUPABASE_URL="https://ytlugfqcoqjzbgzsgqwi.supabase.co"
SUPABASE_ANON_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6Inl0bHVnZnFjb3FqemJnenNncXdpIiwicm9sZSI6ImFub24iLCJpYXQiOjE3OTE1NjQ1MjQsImV4cCI6MjEwNzE0MDUyNH0.F8ls99ko4jHCQUDHE-wdH4hCsvBwsStWLUdSXNPsv30"
SUPABASE_DB_PASSWORD="lunarlogicpulse"
SUPABASE_DB_URL="postgresql+psycopg://postgres.ytlugfqcoqjzbgzsgqwi:lunarlogicpulse@aws-0-ap-south-1.pooler.supabase.com:6543/postgres"

# Frontend auth (same public anon key). Vite only reads VITE_ variables.
VITE_SUPABASE_URL="https://ytlugfqcoqjzbgzsgqwi.supabase.co"
VITE_SUPABASE_ANON_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6Inl0bHVnZnFjb3FqemJnenNncXdpIiwicm9sZSI6ImFub24iLCJpYXQiOjE3OTE1NjQ1MjQsImV4cCI6MjEwNzE0MDUyNH0.F8ls99ko4jHCQUDHE-wdH4hCsvBwsStWLUdSXNPsv30"
# Origin of a deployed backend, needed once the frontend is hosted separately
# (e.g. Vercel). Leave unset for local dev, where the Vite proxy handles /api.
# VITE_API_BASE_URL="https://urbanpulse-backend.onrender.com"

# SQLite is only a local fallback when Supabase is not configured.
DATABASE_URL="sqlite:///./monsoonwatch.db"

# Optional providers. Keep all secrets in .env or backend/.env only.
IMD_API_KEY=""
OPEN_METEO_API_KEY=""
BHUVAN_NRSC_TOKEN=""
MAP_TILES_TOKEN=""
GEMINI_API_KEY=""

SECRET_KEY="change-in-production"
ALLOWED_ORIGINS="http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173"
